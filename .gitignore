# Dependencies — restored with `npm install` from the committed package-lock.json.
node_modules/

# Build output — regenerated by `npm run build`, and what Vercel builds for itself.
dist/
dev-dist/

# Local secrets. The README has you create backend/.env and frontend/.env holding
# DATABASE_URL, JWT_SECRET and GOOGLE_CLIENT_ID — none of which belong in the repo.
# .env.example files are deliberately still tracked.
.env
.env.*
!.env.example

# Logs and editor/OS noise
*.log
npm-debug.log*
.DS_Store
.vscode/
.idea/
